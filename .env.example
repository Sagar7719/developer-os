# ==========================================
# DEVELOPER OS - SYSTEM ENVIRONMENT CONFIG TEMPLATE (v1.0)
# WARNING: NEVER COMMIT REAL SECRETS OR .env FILES TO VERSION CONTROL
# ==========================================

# ------------------------------------------
# CLIENT ENVIRONMENT CONFIGURATION
# ------------------------------------------
VITE_APP_NAME="Developer OS"
VITE_BRAND_NAME="Sagar.dev"
VITE_SITE_URL="https://developer-os.dev"
VITE_OG_IMAGE="https://developer-os.dev/favicon.svg"
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_ENABLE_ANALYTICS=false

# ------------------------------------------
# SERVER ENVIRONMENT CONFIGURATION
# ------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN="http://localhost:5173"
TRUST_PROXY=0

# DATABASE CONFIGURATION (MongoDB)
MONGO_URI="mongodb://localhost:27017/developer_os"

# SECURITY & AUTHENTICATION SECRETS
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-env"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-env"
JWT_REFRESH_EXPIRES_IN="7d"

# CONTACT SYSTEM & EMAIL NOTIFICATIONS (Required in Production)
CONTACT_RECEIVER_EMAIL="admin@developer-os.dev"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# CLOUDINARY MEDIA MANAGEMENT
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
MAX_FILE_SIZE_MB=10

# LOGGING & RATE LIMITING
LOG_LEVEL="info"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# GOOGLE GEMINI AI INTEGRATION (RFC-008)
GEMINI_API_KEY="your_google_gemini_api_key"
GEMINI_MODEL="gemini-2.0-flash"
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=15


# ==========================================
# DEVELOPER OS - SYSTEM ENVIRONMENT CONFIG (v1.0)
# Brand: Sagar.dev
# ==========================================

# ------------------------------------------
# CLIENT ENVIRONMENT CONFIGURATION
# ------------------------------------------
VITE_APP_NAME="Developer OS"
VITE_BRAND_NAME="Sagar.dev"
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_ENABLE_ANALYTICS=false

# ------------------------------------------
# SERVER ENVIRONMENT CONFIGURATION
# ------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN="http://localhost:5173"

# DATABASE CONFIGURATION (MongoDB Atlas)
MONGO_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/developer_os?retryWrites=true&w=majority"

# SECURITY & AUTHENTICATION
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-env"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-env"
JWT_REFRESH_EXPIRES_IN="7d"

# CLOUDINARY MEDIA MANAGEMENT
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# LOGGING
LOG_LEVEL="info"

# SECURITY & RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

